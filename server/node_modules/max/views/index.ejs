	});
	
});
function get_goods_name()
{
	var yanshe= $('#goods_color li.nux').find('img').attr('title');
	var chichun= $('li.nux').find('a').attr('title');
	if(yanshe!=undefined&&chichun!=undefined)
	{
		$("#goods_name").html(chichun+' '+yanshe);
		$("#spec").val(yanshe);
		$("#chima").val(chichun);
	}else if(yanshe!=undefined&&chichun==undefined)
	{
		$("#goods_name").html(yanshe);
		$("#spec").val(yanshe);
	}else if(yanshe==undefined&&chichun!=undefined)
	{
		$("#goods_name").html(chichun);
		$("#chima").val(chichun);
	}
	
}
