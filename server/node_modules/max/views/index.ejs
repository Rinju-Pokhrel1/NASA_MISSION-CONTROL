<script type="text/javascript">
function change_num(n)
{
	var num=Number($("#num").val());
	if(n==1)
	{
		num=num+1;
		$("#num").val(num);
		$("#wfmun").val(num);
		jisuan();
	}else
	{
		if(num>1)
		{
			num=num-1;
			$("#num").val(num);
			$("#wfmun").val(num);
			jisuan();
		}
	}
	
}
function chang_shuliang()
{
	var wfmun=Number($("#wfmun").val());
	$("#num").val(wfmun);
	jisuan();
}
function jisuan()
{
	var wfmun=Number($("#wfmun").val());
	
	$("#showprit").html(wfmun*398);
	
}
$(document).ready(function() {
	$(".cloud").click(function(){
		$(this).parent().addClass('nux');
		$(this).parent().siblings().removeClass('nux');
		get_goods_name();
		
